# Vibe Crypto MCP server for Google Cloud Run (MCP only: no frontend, no desktop app).
#
# deploy.sh stages this file next to a generated requirements.txt and runs
# `gcloud run deploy --source`. requirements.txt is generated by deploy.sh
# (it pins the git ref and the broker packages you chose), so do not commit one.
#
# Runtime contract:
# - The access token arrives from Secret Manager as VIBE_CRYPTO_MCP_TOKEN. Without
#   it the server refuses to start on 0.0.0.0.
# - A Cloud Storage bucket is mounted at /home/vibe/.vibe-trading. That folder is
#   both the runtime root (paper runs, settings, connector JSON files) and the
#   ~/.vibe-trading/.env location the app loads.
# - ORDER tools follow VIBE_CRYPTO_MCP_ENABLE_ORDERS (0 unless deploy.sh --enable-orders).
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv==0.11.32

COPY requirements.txt /tmp/requirements.txt
RUN uv pip install --system --no-cache -r /tmp/requirements.txt

# uid 1000 must match the uid= option of the Cloud Storage volume mount in deploy.sh.
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin vibe \
    && mkdir -p /home/vibe/.vibe-trading \
    && chown -R vibe:vibe /home/vibe

USER vibe
ENV HOME=/home/vibe PYTHONUNBUFFERED=1 PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "exec vibe-crypto-mcp --transport http --host 0.0.0.0 --port ${PORT}"]
