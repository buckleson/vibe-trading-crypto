{
  "name": "vibe-crypto-desktop",
  "version": "0.3.0",
  "private": true,
  "author": "Vibe Crypto contributors",
  "license": "MIT",
  "description": "Vibe Crypto desktop app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "test:locales": "npm run build && node scripts/test-locales.mjs",
    "test:backend-resolution": "npm run build && node scripts/test-backend-resolution.mjs",
    "test:update-safety": "npm run build && node scripts/test-update-safety.mjs",
    "test:packaging-preparation": "node scripts/test-packaging-preparation.mjs",
    "smoke:parent-death": "npm run build && npm run prepare:electron && node scripts/smoke-parent-death.mjs",
    "prepare:electron": "node scripts/prepare-electron.mjs",
    "runtime:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "smoke:credentials": "npm run build && npm run prepare:electron && electron scripts/smoke-credentials.cjs",
    "smoke:lifecycle": "npm run build && npm run prepare:electron && node scripts/test-packaging-preparation.mjs && node scripts/test-locales.mjs && node scripts/test-backend-resolution.mjs && node scripts/smoke-lifecycle.mjs && node scripts/smoke-parent-death.mjs",
    "pack:win": "npm run build && npm run prepare:electron && electron-builder --publish never --win dir",
    "pack:mac": "npm run build && npm run prepare:electron && electron-builder --publish never --mac dir",
    "pack:linux": "npm run build && npm run prepare:electron && electron-builder --publish never --linux dir",
    "dist:mac": "npm run build && npm run prepare:electron && electron-builder --publish never --mac dmg zip",
    "dist:linux": "npm run build && npm run prepare:electron && electron-builder --publish never --linux AppImage deb",
    "installer:win:review": "npm run runtime:win -- -Clean && npm run build && npm run prepare:electron && node scripts/build-review-installer.mjs",
    "installer:win:signed": "node scripts/build-signed-installer.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "test:terminal": "npm run build && node scripts/test-terminal.mjs"
  },
  "overrides": {
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^2.0.0": "^2.1.7",
    "brace-expansion@^5.0.0": "^5.0.12",
    "fast-uri@^3.0.0": "^3.1.9",
    "undici@^6.0.0": "^6.29.1",
    "undici@^7.0.0": "^7.30.1"
  },
  "devDependencies": {
    "@electron-internal/extract-zip": "1.0.4",
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^24.10.0",
    "electron": "43.8.4",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "io.github.buckleson.vibecrypto",
    "productName": "Vibe Crypto",
    "compression": "normal",
    "artifactName": "Vibe-Crypto-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "electronLanguages": [
      "ar",
      "en-GB",
      "en-US",
      "ja",
      "ko",
      "zh-CN"
    ],
    "electronDist": ".cache/electron-dist",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "licenses/Vibe-Crypto-LICENSE.txt"
      },
      {
        "from": "../../NOTICE",
        "to": "licenses/Vibe-Crypto-NOTICE.txt"
      }
    ],
    "win": {
      "icon": "../../assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "runtime/backend",
          "to": "backend"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "useZip": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "../../assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "icon": "../../assets/icon.png",
      "maintainer": "Vibe Crypto contributors"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
